# Copy this file to .env and fill in your key. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=3000
MODEL=claude-haiku-4-5-20251001

# Safety rails on how much text the proxy will forward per request
MAX_CHUNKS=20
MAX_CHUNK_CHARS=6000
CONCURRENCY=4

# Optional. Leave blank for local/dev use (no auth required, matches current
# behavior). Set this to a random string before deploying anywhere other than
# localhost — without it, anyone who finds your server's URL can spend
# against your Anthropic key. The extension sends it back as
# "Authorization: Bearer <token>"; set the same value in the popup's proxy
# settings. Generate one with: openssl rand -hex 32
PROXY_AUTH_TOKEN=
