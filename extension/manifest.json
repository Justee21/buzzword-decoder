{
  "manifest_version": 3,
  "name": "Buzzword Decoder",
  "version": "1.0.0",
  "description": "Translates corporate jargon on any webpage into plain English.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://buzzword-decoder.onrender.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buzzword Decoder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
